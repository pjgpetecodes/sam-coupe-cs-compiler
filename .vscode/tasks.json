{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SAM C#: Build active program",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}\\.vscode\\sam_run.py", "${file}", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "sam-csharp",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning) ([A-Z]+\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    }
  ]
}
